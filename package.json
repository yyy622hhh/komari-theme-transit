    "eslint": "^10.8.1",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-vue": "~10.10.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^9.0.3",
    "tailwindcss": "^4.1.16",
