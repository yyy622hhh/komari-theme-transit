{
  "name": "komari-theme-transit",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "author": {
    "name": "PandaKiko",
    "url": "https://github.com/yyy622hhh/komari-theme-transit"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "build:route-probe": "bun scripts/package-route-probe-plugin.ts",
    "analyze": "TRANSIT_ANALYZE=1 vite build",
    "audit:bundle": "bun scripts/audit-bundle.ts",
    "audit:performance": "bun scripts/audit-performance.ts",
    "audit:reproducible": "bun scripts/audit-reproducible.ts",
    "audit:dependencies": "bun scripts/audit-dependencies.ts",
    "audit:source-size": "bun scripts/audit-source-size.ts",
    "audit:release": "bun scripts/audit-release.ts",
    "type-check": "vue-tsc --build",
    "publish": "bun scripts/publish.ts",
    "test:unit": "bun test tests/unit",
    "test:komari": "bun scripts/komari-lab.ts",
    "test:visual": "bun run build-only && playwright test",
    "test:functional": "VITE_COMPONENT_BOUNDARY_TEST=true bun run build-only && playwright test --config playwright.functional.config.ts",
    "test:performance": "bun run build-only && playwright test --config playwright.performance.config.ts",
    "test:accessibility": "bun run build-only && playwright test tests/visual/accessibility.spec.ts",
    "test:visual:update": "bun run build-only && playwright test --update-snapshots",
    "test:visual:baseline": "bun run build-only && playwright test --update-snapshots=all",
    "lint": "eslint . --fix --cache",
    "lint:eslint": "eslint . --fix --cache",
    "lint:check": "eslint .",
    "icons:generate": "bun scripts/generate-icon-collection.ts",
    "icons:check": "bun scripts/generate-icon-collection.ts --check"
  },
  "dependencies": {
    "@iconify/vue": "5.0.1",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "dayjs": "1.11.23",
    "echarts": "^6.0.0",
    "globe.gl": "^2.46.1",
    "pinia": "4.0.3",
    "reka-ui": "^2.6.1",
    "sortablejs": "^1.15.7",
    "tailwind-merge": "^3.4.0",
    "three": "0.185.1",
    "vue": "^3.5.28",
    "vue-echarts": "^8.0.1",
    "vue-router": "^5.0.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@iconify/json": "2.2.517",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.1.16",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "26.2.0",
    "@types/sortablejs": "^1.15.9",
    "@types/three": "0.185.4",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "0.9.1",
    "archiver": "8.0.0",
    "eslint": "10.8.1",
    "eslint-plugin-format": "2.0.1",
    "eslint-plugin-vue": "10.10.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "9.0.3",
    "tailwindcss": "^4.1.16",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-static-copy": "4.1.1",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vue-tsc": "3.3.10"
  }
}
